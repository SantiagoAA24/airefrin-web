          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "marca": {
            "$ref": "#/components/schemas/MarcaOut"
          },
          "categoria": {
            "$ref": "#/components/schemas/CategoriaOut"
          },
          "capacidad_btu": {
            "type": "integer",
