{
  "openapi": "3.1.0",
  "info": {
    "title": "Airefrin API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/catalogo/equipos": {
      "get": {
        "tags": [
          "catalogo"
        ],
        "summary": "Listar equipos publicados",
        "operationId": "list_equipos_catalogo_equipos_get",
        "parameters": [
          {
            "name": "marca",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Slug de la marca",
              "title": "Marca"
            },
            "description": "Slug de la marca"
          },
          {
            "name": "tipo",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Slug de la categoría / tipo",
              "title": "Tipo"
            },
            "description": "Slug de la categoría / tipo"
          },
          {
            "name": "btu_min",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Capacidad mínima en BTU",
              "title": "Btu Min"
            },
            "description": "Capacidad mínima en BTU"
          },
          {
            "name": "btu_max",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Capacidad máxima en BTU",
              "title": "Btu Max"
            },
            "description": "Capacidad máxima en BTU"
          },
          {
            "name": "destacado",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Solo equipos destacados",
              "title": "Destacado"
            },
            "description": "Solo equipos destacados"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 12,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EquipoListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/catalogo/equipos/{slug}": {
      "get": {
        "tags": [
          "catalogo"
        ],
        "summary": "Obtener ficha de un equipo por slug",
        "operationId": "get_equipo_catalogo_equipos__slug__get",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EquipoDetalle"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/catalogo/marcas": {
      "get": {
        "tags": [
          "catalogo"
        ],
        "summary": "Listar marcas con equipos publicados",
        "operationId": "list_marcas_catalogo_marcas_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MarcaOut"
                  },
                  "type": "array",
                  "title": "Response List Marcas Catalogo Marcas Get"
                }
              }
            }
          }
        }
      }
    },
    "/solicitudes/contacto": {
      "post": {
        "tags": [
          "solicitudes"
        ],
        "summary": "Registrar solicitud de contacto",
        "operationId": "crear_contacto_solicitudes_contacto_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactoCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactoResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CategoriaOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "slug"
        ],
        "title": "CategoriaOut"
      },
      "ContactoCreate": {
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Nombre"
          },
          "telefono": {
            "type": "string",
            "maxLength": 40,
            "minLength": 7,
            "title": "Telefono"
          },
          "correo": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 254
              },
              {
                "type": "null"
              }
            ],
            "title": "Correo"
          },
          "necesidad": {
            "$ref": "#/components/schemas/Necesidad"
          },
          "tipo_espacio": {
            "$ref": "#/components/schemas/TipoEspacio"
          },
          "mensaje": {
            "type": "string",
            "maxLength": 2000,
            "title": "Mensaje",
            "default": ""
          },
          "autorizacion_datos": {
            "type": "boolean",
            "title": "Autorizacion Datos"
          },
          "website": {
            "type": "string",
            "maxLength": 200,
            "title": "Website",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "nombre",
          "telefono",
          "necesidad",
          "tipo_espacio",
          "autorizacion_datos"
        ],
        "title": "ContactoCreate"
      },
      "ContactoResponse": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok",
            "default": true
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "Recibimos tu solicitud. Te contactaremos pronto."
          }
        },
        "type": "object",
        "title": "ContactoResponse"
      },
